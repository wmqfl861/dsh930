{
  "name": "dsh930 — Node 24",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "containerEnv": {
    "DSH_TELEMETRY_DISABLED": "1"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm run build",
  "forwardPorts": [3080],
  "portsAttributes": {
    "3080": {
      "label": "dsh930 Web UI",
      "onAutoForward": "notify"
    }
  }
}
